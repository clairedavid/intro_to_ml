def _disc(rng, centre, radius, n):
    """n points uniformly spread in a disc."""
    r = radius * np.sqrt(rng.uniform(0, 1, n)); t = rng.uniform(0, 2 * np.pi, n)
    return np.c_[centre[0] + r * np.cos(t), centre[1] + r * np.sin(t)]


def size_data(seed=1):
    """One big cluster between two small ones."""
    rng = np.random.default_rng(seed)
    parts = [_disc(rng, (2.3, 8), 1.1, 25), _disc(rng, (8, 8), 3.4, 210), _disc(rng, (13.7, 8), 1.1, 25)]
    return np.vstack(parts), np.repeat([0, 1, 2], [len(p) for p in parts])


def density_data(seed=3):
    """One large sparse cluster next to two small dense ones, close to each other."""
    rng = np.random.default_rng(seed)
    parts = [_disc(rng, (5.6, 8), 4.8, 150), _disc(rng, (13.4, 9.2), 1.0, 100), _disc(rng, (13.4, 6.8), 1.0, 100)]
    return np.vstack(parts), np.repeat([0, 1, 2], [len(p) for p in parts])


def _match_colours(lab_true, lab_km, K):
    """Give each k-means cluster the colour of the true cluster it overlaps most (one-to-one)."""
    best = max(permutations(range(K)), key=lambda p: sum((lab_true == p[k])[lab_km == k].sum() for k in range(K)))
    return np.array([best[k] for k in lab_km])


def kmeans_fails_fig(X, lab_true, K=3):
    """Left: the true clusters. Arrow. Right: what k-means finds, with its centroids."""
    c, mu = kmeans(X, K)
    lab_km = _match_colours(lab_true, c, K)
    fig = plt.figure(figsize=(11, 4.6), dpi=220)
    gs = fig.add_gridspec(1, 3, width_ratios=[1, 0.55, 1], wspace=0)
    ax_l, ax_a, ax_r = (fig.add_subplot(gs[0, i]) for i in range(3))
    for ax, labs in ((ax_l, lab_true), (ax_r, lab_km)):
        _box(ax, ticks=False)
        ax.scatter(X[:, 0], X[:, 1], c=[INTRO_COLS[k] for k in labs], s=11, edgecolor="none", alpha=0.9)
    ax_r.scatter(mu[:, 0], mu[:, 1], s=130, marker="P", c=AX, edgecolor="white", lw=0.9, zorder=5)
    # same grey arrow as the intro figure
    ax_a.axis("off")
    W, H = fig.get_size_inches(); bb = ax_a.get_position()
    r = (bb.height * H) / (bb.width * W)
    ax_a.set_xlim(0, 1); ax_a.set_ylim(-r / 2, r / 2)
    Lr, xc = 0.42, 0.50
    x0, x1 = xc - Lr / 2, xc + Lr / 2
    sh, hh, hl = 0.082 * Lr, 0.178 * Lr, 0.31 * Lr
    ax_a.add_patch(plt.Polygon([(x0, -sh), (x1 - hl, -sh), (x1 - hl, -hh), (x1, 0),
                                (x1 - hl, hh), (x1 - hl, sh), (x0, sh)], closed=True, fc="#b5b5b5", ec="none"))
    return fig


fig = kmeans_fails_fig(*size_data())
glue("plot_kmeans_fail_sizes", fig, display=False)

fig = kmeans_fails_fig(*density_data())
glue("plot_kmeans_fail_densities", fig, display=False)
